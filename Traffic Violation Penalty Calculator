fine_rules = {
    "speeding": 1000,
    "no_helmet": 500,
    "signal_jump": 1500
}

total = 0
repeat_count = 0

vehicle = input("Enter vehicle category: ")
n = int(input("Enter number of violations: "))

for i in range(n):
    offence = input("Enter offence (speeding/no_helmet/signal_jump): ").lower()
    repeat = input("Repeat offence? (yes/no): ").lower()

    if offence in fine_rules:
        fine = fine_rules[offence]

        if repeat == "yes":
            fine = fine * 2
            repeat_count += 1

        total += fine
        print("Fine:", fine)
    else:
        print("Invalid offence")

print("Vehicle category:", vehicle)
print("Total penalty:", total)

if repeat_count >= 3:
    print("Disqualification condition met")
else:
    print("No disqualification condition met")
