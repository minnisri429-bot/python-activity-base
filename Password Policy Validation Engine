import string

password = input("Enter password: ")
errors = []

if len(password) < 8:
    errors.append("Minimum length must be 8 characters")

if not any(c.isupper() for c in password):
    errors.append("Missing uppercase letter")

if not any(c.islower() for c in password):
    errors.append("Missing lowercase letter")

if not any(c.isdigit() for c in password):
    errors.append("Missing digit")

if not any(c in string.punctuation for c in password):
    errors.append("Missing special character")

# Check three consecutive identical characters
for i in range(len(password) - 2):
    if password[i] == password[i + 1] == password[i + 2]:
        errors.append("Three consecutive repeated characters")
        break

# Check prohibited substrings
if "password" in password.lower():
    errors.append("Contains prohibited word: password")

if errors:
    print("Invalid password:")
    for error in errors:
        print("-", error)
else:
    print("Password is valid")

