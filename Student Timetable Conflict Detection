23. Student Timetable Conflict Detection
Algorithm
1. Start.
2. Enter course schedules as tuples containing course name, start time, end time, and room.
3. Convert the time strings into comparable values.
4. Compare every pair of courses.
5. Check for overlapping times and unavailable rooms.
6. Display timetable conflicts or confirm that the timetable is valid.
7. Stop.
Flowchart
Start
↓
Enter course tuples and unavailable rooms
↓
Compare course time intervals
↓
Overlapping courses or unavailable room?
Yes
↓
Report conflict

No
↓
No conflict


Display timetable status
↓
Stop

# Course format: (name, start, end, room)
courses = [
    ("Python", "09:00", "10:00", "R1"),
    ("Maths", "09:30", "10:30", "R2"),
    ("Physics", "10:30", "11:30", "R3")
]

# Times are represented as strings in HH:MM format.
unavailable_rooms = ["R3"]

def to_minutes(time):
    hours, minutes = map(int, time.split(":"))
    return hours * 60 + minutes

conflict = False

for i in range(len(courses)):
    name1, start1, end1, room1 = courses[i]

    if room1 in unavailable_rooms:
        print(name1, "- Room", room1, "is unavailable")
        conflict = True

    for j in range(i + 1, len(courses)):
        name2, start2, end2, room2 = courses[j]

        # Check overlapping time periods
        if (to_minutes(start1) < to_minutes(end2)
                and to_minutes(start2) < to_minutes(end1)):
            print(name1, "and", name2, "- Time conflict")
            conflict = True

if not conflict:
    print("Timetable is valid")
else:
    print("Timetable has conflicts")
