from datetime import datetime

# Vehicle rates per hour
rates = {"bike": 10, "car": 20, "truck": 30}

# Daily maximum charges
limits = {"bike": 100, "car": 200, "truck": 300}

vehicle = input("Enter vehicle (bike/car/truck): ").lower()

if vehicle not in rates:
    print("Invalid vehicle category!")

else:
    entry = input("Enter entry time (HH:MM): ")
    exit_time = input("Enter exit time (HH:MM): ")

    try:
        start = datetime.strptime(entry, "%H:%M")
        end = datetime.strptime(exit_time, "%H:%M")

        # Calculate duration, including overnight parking
        if end <= start:
            end = end.replace(day=2)

        hours = (end - start).total_seconds() / 3600

        # Charge for every started hour
        billable_hours = int(hours)
        if hours > billable_hours:
            billable_hours += 1

        fee = billable_hours * rates[vehicle]

        # Overnight charge
        overnight = end.date() > start.date()
        if overnight:
            fee += 50

        # Apply daily maximum
        fee = min(fee, limits[vehicle])

        # Penalty for parking over 12 hours
        penalty = 0
        if hours > 12:
            penalty = 100

        total = fee + penalty

        print("\n--- Parking Receipt ---")
        print("Vehicle:", vehicle)
        print("Duration:", hours, "hours")
        print("Parking Fee: Rs.", fee)
        print("Penalty: Rs.", penalty)
        print("Total Fee: Rs.", total)

    except ValueError:
        print("Invalid time! Enter time in HH:MM format.")
