↓
Stop

n = int(input("Enter diamond size: "))

if n <= 0:
    print("Invalid size. Enter a positive number.")
else:
    # Upper half
    for i in range(1, n + 1):
        print(" " * (n - i), end="")
        if i == 1:
            print("1")
        else:
            print("1" + " " * (2 * i - 3) + str(i))

    # Lower half
    for i in range(n - 1, 0, -1):
        print(" " * (n - i), end="")
        if i == 1:
            print("1")
        else:
            print("1" + " " * (2 * i - 3) + str(i))
