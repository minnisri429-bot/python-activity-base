# Manufacturing Cost and Profitability Analysis

material = float(input("Enter material cost: "))
labour = float(input("Enter labour charges: "))
wastage = float(input("Enter wastage cost: "))
machine = float(input("Enter machine cost: "))

quantity = int(input("Enter number of products: "))
selling_price = float(input("Enter selling price per product: "))
target = float(input("Enter profit target percentage: "))

# Calculate total cost and sales
total_cost = material + labour + wastage + machine
total_sales = quantity * selling_price

# Calculate profit or loss
profit = total_sales - total_cost

if total_cost > 0:
    profit_percent = (profit / total_cost) * 100
else:
    profit_percent = 0

# Display results
print("\n--- Manufacturing Report ---")
print("Total Cost:", total_cost)
print("Total Sales:", total_sales)
print("Profit/Loss:", profit)
print("Profit Percentage:", profit_percent, "%")

# Check profit target
if profit >= 0 and profit_percent >= target:
    print("Profit Target Achieved")
else:
    print("Profit Target Not Achieved") 
