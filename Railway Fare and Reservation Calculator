# Railway Fare and Reservation Calculator

n = int(input("Enter number of passengers: "))

for i in range(1, n + 1):
    print("\nPassenger", i)

    name = input("Enter passenger name: ")
    age = int(input("Enter age: "))
    distance = int(input("Enter distance in km: "))

    print("Classes: 1. Sleeper  2. AC")
    cls = int(input("Select class (1 or 2): "))

    # Distance-based fare
    if distance <= 100:
        rate = 1
    elif distance <= 500:
        rate = 2
    else:
        rate = 3

    # Class charges
    if cls == 1:
        class_rate = 1
        reservation_fee = 20
    else:
        class_rate = 2
        reservation_fee = 50

    fare = distance * rate * class_rate

    # Age-based concession
    if age < 5:
        fare = 0
        reservation_fee = 0
    elif age >= 60:
        fare = fare * 0.8

    total = fare + reservation_fee

    print("\n--- Ticket Details ---")
    print("Name:", name)
    print("Base Fare:", fare)
    print("Reservation Fee:", reservation_fee)
    print("Total Fare: Rs.", total)

    cancel = input("Cancel ticket? (yes/no): ")

    if cancel.lower() == "yes":
        penalty = total * 0.25
        refund = total - penalty
        print("Cancellation Penalty: Rs.", penalty)
        print("Refund Amount: Rs.", refund)
